@echo off
title 言迹 (ParaScribe) - 高准度音视频转文字工具
echo ======================================================================
echo                  言迹 (ParaScribe) 高准度音视频转文字工具
echo   * 支持纯音频: .m4a, .mp3, .wav, .flac, .aac, .ogg, .opus 等
echo   * 支持视频音轨: .mp4, .mkv, .avi, .mov, .webm, .flv 等
echo   * 支持直接将单个或多个音视频文件拖拽到本批处理文件上进行批量转录
echo ======================================================================
echo.

if "%~1"=="" (
    echo [提示] 未拖拽指定文件，正在扫描当前目录下的音视频文件...
    echo.
    python "%~dp0ParaScribe.py"
) else (
    echo [提示] 检测到拖拽输入文件，正在开始处理...
    echo.
    python "%~dp0ParaScribe.py" %*
)

echo.
echo ======================================================================
echo   处理结束，请查看上方转录汇报或当前目录下的输出文件与 parascribe.log
echo ======================================================================
echo.
pause
